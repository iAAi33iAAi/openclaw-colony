# OpenClaw Colony — Windows / Docker Desktop Configuration
# 
# INSTRUCTIONS:
# 1. Copy this file and rename it to .env
#    In File Explorer: right-click → copy → paste → rename to .env
#    OR in Command Prompt: copy .env.windows .env
#
# 2. Fill in your Stripe values (leave blank for mock mode)
# 3. Run: docker compose up --build

# ── Node Identity ─────────────────────────────────────────────────────
COLONY_NODE_ID=node-001-bethel
COLONY_NODE_URL=http://localhost:8000
COLONY_BAS_SECRET=1bc522bf80801c054fc7af993d3c8ec451d4ae7150aaff6e9da614766bc83eb2
COLONY_ADMIN_KEY=051f08046d0aa47cddf7156d784d1060

# ── Safety Settings ───────────────────────────────────────────────────
COLONY_BIOMETRIC_REQUIRED=false
COLONY_DEV_MODE=false
COLONY_AUTH_ENABLED=true
COLONY_DB_PATH=/data/colony.db

# ── Rate Limits ───────────────────────────────────────────────────────
COLONY_RATE_PROCESS=30/minute
COLONY_RATE_ADMIN=60/minute
COLONY_RATE_WEBHOOK=120/minute

# ── MANNA Payment Rail ────────────────────────────────────────────────
# Leave blank to run in MOCK mode (no real charges)
# Fill in after setting up Stripe Connect accounts
COLONY_MANNA_CENTS=100
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COMMUNITY_ACCOUNT=
STRIPE_CREW_ACCOUNT=
STRIPE_ARCHITECT_ACCOUNT=

# ── Federation (leave blank for standalone node) ──────────────────────
COLONY_PEERS=
FEDERATION_SYNC_INTERVAL=60
FEDERATION_QUORUM=0.51
PROPOSAL_TTL_HOURS=72
