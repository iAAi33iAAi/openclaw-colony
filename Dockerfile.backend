# OpenClaw Colony — Backend Dockerfile
# Pre-built: Rust kernel compiled at build time
# No Rust compiler needed on the host machine

FROM python:3.11-slim AS base

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust (needed to compile the PyO3 kernel)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Install maturin for PyO3 builds
RUN pip install --no-cache-dir maturin

WORKDIR /app

# ── Build Rust kernel ─────────────────────────────────────────
COPY backend/aethel-kernel/ ./aethel-kernel/
RUN cd aethel-kernel && \
    maturin build --release --out /wheels && \
    pip install /wheels/*.whl

# ── Install Python dependencies ───────────────────────────────
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Copy application code ─────────────────────────────────────
COPY backend/ .

# ── Data directory for SQLite lineage chain ───────────────────
RUN mkdir -p /data /logs

# ── Health check script ───────────────────────────────────────
RUN echo '#!/bin/sh\ncurl -sf http://localhost:8000/health || exit 1' > /healthcheck.sh && \
    chmod +x /healthcheck.sh

EXPOSE 8000

# Genesis runs first, then the server starts
CMD ["sh", "-c", "python dev_commit_init.py && uvicorn colony-agents.orchestrator.colony_coordinator_v2:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"
