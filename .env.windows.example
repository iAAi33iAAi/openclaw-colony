# OpenClaw Colony — Windows / Docker Desktop environment template
# Copy this file to .env locally. Do not commit your real .env file.
# Replace secret placeholders locally using a secret manager or a secure generator.
#
# Example local setup:
#   copy .env.windows.example .env
#   docker compose up --build
#
# This template contains no credentials. Empty Stripe settings use mock mode.

# ── Node identity ────────────────────────────────────────────────────
COLONY_NODE_ID=node-001
COLONY_NODE_URL=http://localhost:8000
COLONY_ENV=development
COLONY_DEV_MODE=false

# ── Security ─────────────────────────────────────────────────────────
COLONY_BAS_SECRET=replace-with-a-unique-random-secret-from-your-secret-manager
COLONY_ADMIN_KEY=replace-with-a-unique-random-admin-secret
COLONY_BIOMETRIC_REQUIRED=true
COLONY_AUTH_ENABLED=true
COLONY_APPROVAL_REQUIRED=true
COLONY_DB_PATH=/data/colony.db

# ── Rate limits ──────────────────────────────────────────────────────
COLONY_RATE_PROCESS=30/minute
COLONY_RATE_ADMIN=60/minute
COLONY_RATE_WEBHOOK=120/minute

# ── MANNA / Stripe payment rail ──────────────────────────────────────
# Leave these empty for mock mode. Configure live Stripe only after the
# execution-admission boundary and production deployment are reviewed.
COLONY_MANNA_CENTS=100
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COMMUNITY_ACCOUNT=
STRIPE_CREW_ACCOUNT=
STRIPE_ARCHITECT_ACCOUNT=

# ── Federation (blank for standalone node) ────────────────────────────
COLONY_PEERS=
FEDERATION_SYNC_INTERVAL=30
FEDERATION_QUORUM=0.51
PROPOSAL_TTL_HOURS=72

# ── Optional integrations ────────────────────────────────────────────
AETHEL_SPORTS_MATH_URL=
AETHEL_PROJECT_MONO_URL=
AETHEL_UNDERMOON_URL=
AETHEL_GRID_URL=
CAIOS_SOURCE_PATH=
CAIOS_ADVISORY_ENABLED=false

# Important: setting COLONY_BIOMETRIC_REQUIRED=false is permitted only
# when COLONY_DEV_MODE=true and COLONY_ENV is development or test.
# Production deployments must keep biometric enforcement enabled.
